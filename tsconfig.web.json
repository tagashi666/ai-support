{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./web/src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["web/src/**/*.ts", "web/src/**/*.tsx", "web/vite.config.ts", "web/e2e/**/*.ts", "src/shared/**/*.ts"]
}
