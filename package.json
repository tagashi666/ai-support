{
  "name": "ai-support",
  "version": "1.15.0",
  "description": "Self-hosted Telegram support inbox with AI-assisted replies, knowledge base and operator dashboard",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/tagashi666/ai-support#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tagashi666/ai-support.git"
  },
  "bugs": {
    "url": "https://github.com/tagashi666/ai-support/issues"
  },
  "keywords": ["telegram", "support", "ai", "helpdesk", "self-hosted"],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "selfcheck": "tsx src/cli/selfcheck.ts",
    "test": "node --import tsx scripts/uitest.ts && node --import tsx scripts/smoke.ts && node --import tsx scripts/webtest.ts && node --import tsx scripts/aitest.ts && node --import tsx scripts/minetest.ts && node --import tsx scripts/notifytest.ts && node --import tsx scripts/sectest.ts",
    "kb:mine": "tsx src/cli/kbmine.ts",
    "rwprobe": "tsx src/cli/rwprobe.ts",
    "pack": "bash scripts/pack.sh",
    "release:check": "bash scripts/releasecheck.sh"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.1",
    "grammy": "^1.45.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
