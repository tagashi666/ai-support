# ---------- Telegram (необязательно) ----------
# Пустое значение оставляет Telegram-каналы выключенными: голая панель,
# шаблоны, база знаний и настройки всё равно запускаются.
BOT_TOKEN=
# Несколько ботов одновременно. Если массив задан, BOT_TOKEN игнорируется.
# Один бот может обслуживать и обычную личку, и несколько Telegram Business-аккаунтов.
# TELEGRAM_BOTS_JSON=[{"id":"telegram:main","name":"Главный бот","token":"123:token"},{"id":"telegram:vip","name":"VIP-бот","token":"456:token"}]
TELEGRAM_BOTS_JSON=[]
# Включи Business Mode: @BotFather → Bot Settings → Business Mode → Enable
# Затем подключи бота в аккаунте поддержки:
#   Настройки → Telegram для бизнеса → Чат-боты
# Права выдай только два: отвечать на сообщения и отмечать прочитанным.

# Куда слать уведомления о просроченных ответах (id чата или канала).
ALERT_CHAT_ID=
# Внешний адрес панели — чтобы из уведомления открывался нужный диалог
PANEL_URL=https://support.example.com
# Подробность уведомлений: all — каждое сообщение клиента и каждый ответ AI,
# important — только требующее вмешательства, minimal — передачи и просрочки.
NOTIFY_LEVEL=all

# ---------- Панель ----------
PANEL_PORT=8080
PANEL_HOST=127.0.0.1
# Только ASCII. Сгенерируй: openssl rand -hex 32
PANEL_TOKEN=

# ---------- Хранилище ----------
DB_PATH=./data/ai-support.db
MEDIA_DIR=./data/media
# Максимальный размер одного файла и общий бюджет каталога вложений.
MEDIA_MAX_FILE_MB=25
MEDIA_MAX_TOTAL_MB=1024
KB_DIR=./kb
# Черновики майнера лежат отдельно от опубликованной базы знаний
DRAFT_DIR=./data/kb-draft

# ---------- Бедолага ----------
BEDOLAGA_ENABLED=false
BEDOLAGA_API_URL=https://bot.example.com/api
BEDOLAGA_API_TOKEN=
BEDOLAGA_POLL_SECONDS=60
BEDOLAGA_FAQ_LANGUAGE=ru

# ---------- Панель Remnawave (подписка и устройства) ----------
REMNAWAVE_ENABLED=false
REMNAWAVE_URL=https://panel.example.com
REMNAWAVE_TOKEN=
# Запрет разрушающих действий на уровне кода: сброс устройств и перевыпуск
# подписки отказываются работать даже при доступе к панели.
REMNAWAVE_READONLY=true
# Несколько Remnawave-панелей. При непустом массиве legacy-поля выше игнорируются.
# REMNAWAVE_PANELS_JSON=[{"id":"remnawave:eu","name":"EU","url":"https://eu.example.com","token":"secret","readOnly":true},{"id":"remnawave:us","name":"US","url":"https://us.example.com","token":"secret","readOnly":true}]
REMNAWAVE_PANELS_JSON=[]

# ---------- Состояние серверов ----------
# Позволяет AI отвечать на вопросы вида «всё ли в порядке с Германией».
# Слепок снимается нами и отдаётся модели текстом: доступа к панели у неё нет.
NODES_STATUS_ENABLED=false
NODES_POLL_SECONDS=120
# Слепок старше этого срока модель обязана считать отсутствующим
NODES_STALE_MINUTES=15

# ---------- Свой Support API (карточка клиента) ----------
SUPPORT_API_ENABLED=false
SUPPORT_API_URL=https://api.example.com
SUPPORT_API_TOKEN=
SUPPORT_API_USER_PATH=/api/support/user_info

# ---------- Обновления ----------
# Панель проверяет GitHub и создаёт приватную заявку на точный release-тег.
# Docker socket приложению не передаётся. Кнопка сразу запускает ограниченный
# systemd host-updater, если он установлен через install.sh или scripts/install-host-updater.sh.
UPDATE_ENABLED=true
UPDATE_REPOSITORY=tagashi666/ai-support
# prerelease показывает и RC, stable — только стабильные релизы.
UPDATE_CHANNEL=prerelease
UPDATE_CHECK_MINUTES=15
UPDATE_REQUEST_FILE=./data/update-request.json
UPDATE_STATUS_FILE=./data/update-status.json

# Добавление источников из панели использует отдельный ограниченный executor.
SOURCE_REQUEST_FILE=./data/source-request.json
SOURCE_STATUS_FILE=./data/source-status.json

# ---------- AI (необязательно) ----------
# off      — не трогает диалоги вообще
# suggest  — пишет предложку, отправляет человек  (начинай с этого)
# auto     — отправляет сам, когда ворота пропускают
# Готовые конфиги провайдеров и расчёт стоимости — в PROVIDERS.md
AI_MODE=off
AI_BASE_URL=https://api.groq.com/openai/v1
# Ключей можно указать несколько через запятую: лимит у бесплатных тарифов
# считается на ключ, и перебрать их быстрее, чем ждать сброса окна.
# Отвергнутый ключ (401) помечается мёртвым и больше не используется.
AI_API_KEY=
# Модель и запасную можно менять из панели без перезапуска
AI_MODEL=qwen/qwen3.8-27b
# Production-резерв для текстовых обращений. Фото в него не отправляются.
AI_MODEL_FALLBACK=openai/gpt-oss-120b
# Явный allowlist моделей, которым можно передавать изображения.
AI_VISION_MODELS=qwen/qwen3.8-27b
# none выключает рассуждения у Qwen; для GPT-OSS автоматически применяется low.
AI_REASONING_EFFORT=none
# Размышления reasoning-моделей в тегах <think> вырезаются автоматически —
# отдельной настройки не требуется.
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=700
AI_MIN_CONFIDENCE=0.75
# Предохранитель от зацикливания в одном диалоге. 0 — без предела.
AI_AUTO_PER_HOUR=12
# Пауза AI после ответа оператора в том же диалоге. 0 — выключено.
AI_HUMAN_HOLD_MINUTES=30
# Не отвечать на сообщения старше этого возраста (защита от разбора завалов)
AI_MAX_AGE_MINUTES=60
# Пауза перед разбором: клиент дописывает мысль в несколько сообщений
AI_DEBOUNCE_SECONDS=12
# Что уходит клиенту, когда AI зовёт человека. Дальше модель молчит по
# существу, пока оператор не ответит. Правится в панели.
AI_HANDOFF_MESSAGE=Передал ваш вопрос специалисту — он ответит здесь же. Пожалуйста, дождитесь ответа.
AI_HANDOFF_REPEAT_MINUTES=60
# Сколько статей и последних сообщений добавлять в запрос модели.
AI_KB_LIMIT=5
AI_HISTORY_LIMIT=12
# Обрезка одной выдержки из базы знаний, чтобы не раздувать вход
AI_KB_CHARS=1200
# Майнинг базы знаний: потолок одного запроса и пауза между ними.
# Считается против TPM выбранной модели Groq.
AI_MINE_BUDGET_TOKENS=4500
AI_MINE_PACE_MS=20000
# Потолок ответа при майнинге: за один запрос модель пишет несколько статей
AI_MINE_MAX_TOKENS=3500
# После закрытия диалога предложить статьи в черновики. Ничего не
# публикуется без подтверждения оператора.
AI_AUTO_LEARN=false
# Отправлять фото клиента в модель. Текстовый fallback фото не получает.
# Берутся до трёх последних фото из всей серии сообщений клиента.
AI_VISION=true
AI_VISION_MAX_IMAGES=3
# Столько ждём фонового скачивания фото, чтобы не проиграть гонку воркеру.
AI_VISION_WAIT_MS=4000
# Адреса, которые AI разрешено называть клиенту. Всё остальное — домены,
# ip, идентификаторы, ключи — вырезается фильтром перед отправкой.
AI_ALLOWED_DOMAINS=example.com
# Локальным моделям на CPU нужно куда больше времени
AI_TIMEOUT_MS=45000
AI_BRAND=Поддержка
# Манера ответа — правится в панели без перезапуска
AI_REPLY_STYLE=Пиши сплошным текстом в два-три предложения. Нумерованные и маркированные списки не используй.
# Нет ответа в базе знаний — клиенту само ничего не уходит, зовём человека
AI_REQUIRE_KB=true

# ---------- Расшифровка голосовых ----------
# У Groq whisper бесплатен: 2000 запросов и 28 800 секунд аудио в сутки.
TRANSCRIBE_ENABLED=false
TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-large-v3-turbo

# ---------- SLA ----------
SLA_FIRST_RESPONSE_MINUTES=30
SLA_CHECK_SECONDS=120
# Не будить из-за архивных диалогов и не слать больше N уведомлений за цикл
SLA_MAX_AGE_HOURS=24
SLA_MAX_ALERTS_PER_CYCLE=5

LOG_LEVEL=info
