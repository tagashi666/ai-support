# ai-support: конфигурация.
#
# Достаточно блока «Обязательно». Всё остальное работает по умолчанию из кода:
# строки в блоках «Интеграции» и «Расширенное» закомментированы, и значение в
# каждой из них равно умолчанию (или показывает формат). Раскомментируйте
# строку, только если хотите изменить поведение. Не копируйте сюда всё подряд:
# старая копия умолчания перекроет улучшение в новой версии.
#
# Часть настроек AI дублируется в панели (Настройки). Они помечены
# «меняется в панели»: .env задаёт стартовое значение, а после первого
# сохранения в панели значение из базы главнее, и правка .env уже ничего не
# меняет. Посмотреть, что перекрыто, можно в панели.

# ======================= Обязательно =======================

# Токен входа в панель. Только ASCII, не короче 16 символов.
# install.sh генерирует его сам; вручную: openssl rand -hex 32
PANEL_TOKEN=
# Токен Telegram-бота из @BotFather. Пусто — Telegram-каналы выключены,
# панель, шаблоны и база знаний всё равно запускаются.
BOT_TOKEN=
# Ключ AI-провайдера (можно несколько через запятую). Пусто — AI выключен.
AI_API_KEY=
# Чат или канал для уведомлений о просроченных ответах (id).
ALERT_CHAT_ID=
# Внешний адрес ЭТОЙ панели (не Remnawave): из уведомления откроется нужный
# диалог. Пример: https://support.example.com
PANEL_URL=

# ======================= Интеграции =======================
# Для каждой нужны флаг ENABLED=true, адрес и токен: без пары URL+токен
# приложение при включённом флаге не стартует.

# --- Bedolaga ---
# BEDOLAGA_ENABLED=true
# BEDOLAGA_API_URL=https://bot.example.com/api
# BEDOLAGA_API_TOKEN=

# --- MiniShop ---
# Режим plugin использует постоянный service token из deploy/minishop-plugin,
# токен не короче 24 символов. Режим admin принимает ограниченный по времени
# AdminBearer и годится в основном для диагностики.
# MINISHOP_ENABLED=true
# MINISHOP_API_URL=https://shop.example.com
# MINISHOP_API_TOKEN=

# --- Панель Remnawave (подписка и устройства) ---
# REMNAWAVE_ENABLED=true
# REMNAWAVE_URL=https://panel.example.com
# REMNAWAVE_TOKEN=
# Несколько панелей Remnawave. При непустом массиве REMNAWAVE_ENABLED/URL/TOKEN
# выше игнорируются.
# REMNAWAVE_PANELS_JSON=[{"id":"remnawave:eu","name":"EU","url":"https://eu.example.com","token":"secret","readOnly":true}]

# --- Состояние серверов для AI (нужна Remnawave выше) ---
# NODES_STATUS_ENABLED=true

# --- Свой Support API (карточка клиента) ---
# SUPPORT_API_ENABLED=true
# SUPPORT_API_URL=https://api.example.com
# SUPPORT_API_TOKEN=

# --- Расшифровка голосовых ---
# TRANSCRIBE_ENABLED=true
# TRANSCRIBE_BASE_URL=https://api.example.com/openai/v1
# TRANSCRIBE_API_KEY=

# --- Несколько Telegram-ботов ---
# Если массив задан, BOT_TOKEN игнорируется. Business Mode: @BotFather →
# Bot Settings → Business Mode → Enable, затем в аккаунте поддержки
# Настройки → Telegram для бизнеса → Чат-боты (права: отвечать и отмечать
# прочитанным).
# TELEGRAM_BOTS_JSON=[{"id":"telegram:main","name":"Main","token":"123:token"}]

# ======================= Расширенное =======================
# Значения ниже совпадают с умолчаниями в src/config.ts.

# --- AI ---
# off — не трогает диалоги; shadow; suggest — пишет предложку, отправляет
# человек (начинай с неё); auto — отправляет сам, когда ворота пропускают.
# Умолчание: suggest, если задан AI_API_KEY, иначе off.
# Меняется в панели (значение из панели главнее).
# AI_MODE=suggest
# Провайдеры и расчёт стоимости: PROVIDERS.md
# AI_BASE_URL=https://api.groq.com/openai/v1
# Меняется в панели: модель и запасная (запасная без фото).
# AI_MODEL=qwen/qwen3.8-27b
# AI_MODEL_FALLBACK=openai/gpt-oss-120b
# Модели, которым можно передавать изображения.
# AI_VISION_MODELS=qwen/qwen3.8-27b
# AI_VISION=true
# AI_VISION_MAX_IMAGES=3
# AI_VISION_WAIT_MS=4000
# Умолчание пусто (рассуждения не ограничены). Для Qwen на Groq поставьте none,
# иначе рассуждения съедят лимит токенов; для GPT-OSS применяется low.
# AI_REASONING_EFFORT=
# AI_TEMPERATURE=0.3
# При включённых рассуждениях (AI_REASONING_EFFORT не none или не задан)
# потолок автоматически поднимается до 1000, чтобы JSON ответа не обрывался.
# AI_MAX_TOKENS=700
# AI_TIMEOUT_MS=45000
# Домены, которые AI разрешено называть клиенту (через пробел, запятую или ;).
# Всё остальное (домены, ip, ключи) вырезается фильтром. Умолчание пусто.
# AI_ALLOWED_DOMAINS=
# Сколько статей и последних сообщений добавлять в запрос модели.
# AI_KB_LIMIT=5
# AI_HISTORY_LIMIT=20
# Потолок истории в символах: старые сообщения отрезаются первыми.
# AI_HISTORY_CHARS=2500
# Похожие ответы оператора из прошлых диалогов как образец манеры (0 — выкл).
# AI_EXAMPLES=3
# AI_EXAMPLES_CHARS=900
# Сколько закрытых диалогов копить перед одним проходом автообучения.
# AI_AUTO_LEARN_BATCH=5
# «Печатает…» и пауза 1–4 с перед автоответом в Telegram.
# AI_TYPING_INDICATOR=true
# В чате с ботом ответ «печатается» на глазах (черновик Telegram). В Business
# такого метода нет — там остаётся «печатает…».
# AI_STREAM_REPLY=true
# AI_KB_CHARS=4200
# Пауза перед разбором: клиент дописывает мысль в несколько сообщений.
# AI_DEBOUNCE_SECONDS=12
# Майнинг базы знаний: потолок запроса, пауза и потолок ответа.
# AI_MINE_BUDGET_TOKENS=4500
# AI_MINE_PACE_MS=20000
# AI_MINE_MAX_TOKENS=3500

# Меняются в панели → Настройки (значение из панели главнее):
# AI_MIN_CONFIDENCE=0.9
# Предохранитель от зацикливания в одном диалоге. 0 — без предела.
# AI_AUTO_PER_HOUR=12
# Пауза AI после ответа оператора в том же диалоге. 0 — выключено.
# AI_HUMAN_HOLD_MINUTES=30
# Не отвечать на сообщения старше этого возраста.
# AI_MAX_AGE_MINUTES=60
# AI_BRAND=Поддержка
# AI_REPLY_STYLE=Пиши сплошным текстом в два-три предложения. Нумерованные и маркированные списки не используй: если шагов несколько, объедини их в связную фразу. Обращайся на «вы», без канцелярита и без извинений.
# Нет ответа в базе знаний — клиенту само ничего не уходит, зовём человека.
# AI_REQUIRE_KB=true
# AI_HANDOFF_MESSAGE=Передал ваш вопрос специалисту — он ответит здесь же. Пожалуйста, дождитесь ответа.
# AI_HANDOFF_REPEAT_MINUTES=60
# После закрытия диалога предложить статьи в черновики (без публикации).
# AI_AUTO_LEARN=false
# Подробность уведомлений: all — всё, important — только требующее
# вмешательства, minimal — передачи человеку и просрочки.
# NOTIFY_LEVEL=all
# SLA_FIRST_RESPONSE_MINUTES=30

# --- SLA ---
# SLA_CHECK_SECONDS=120
# SLA_MAX_AGE_HOURS=24
# SLA_MAX_ALERTS_PER_CYCLE=5

# --- Опрос интеграций ---
# BEDOLAGA_POLL_SECONDS=20
# BEDOLAGA_FAQ_LANGUAGE=ru
# MINISHOP_NAME=MiniShop
# MINISHOP_API_MODE=plugin
# MINISHOP_POLL_SECONDS=30
# SUPPORT_API_USER_PATH=/api/support/user_info
# Запрет разрушающих действий (сброс устройств, перевыпуск подписки).
# REMNAWAVE_READONLY=true
# NODES_POLL_SECONDS=120
# Слепок старше этого срока модель обязана считать отсутствующим.
# NODES_STALE_MINUTES=15
# TRANSCRIBE_MODEL=whisper-large-v3-turbo

# --- Панель и хранилище ---
# Порт панели на хосте (Docker). Занят другим сервисом — поменяйте здесь;
# внутри контейнера панель всё равно слушает 8080.
# PANEL_PUBLISH_PORT=8080
# Адрес хоста, на котором публикуется порт. 127.0.0.1 — доступ только с
# сервера (nginx, Caddy, cloudflared с network_mode: host, SSH-туннель).
# 0.0.0.0 открывает панель всему интернету в обход UFW — не рекомендуется.
# PANEL_BIND=127.0.0.1
# Только для запуска без Docker. В Docker их задаёт docker-compose.yml
# (0.0.0.0:8080) — не трогайте: правка здесь не действует.
# PANEL_PORT=8080
# PANEL_HOST=127.0.0.1
# Пять ключей ниже в Docker задаются в docker-compose.yml и сильнее .env:
# DB_PATH, MEDIA_DIR, KB_DIR, DRAFT_DIR (и PANEL_HOST выше). Значения для
# запуска без Docker:
# DB_PATH=./data/ai-support.db
# MEDIA_DIR=./data/media
# KB_DIR=./kb
# DRAFT_DIR=./data/kb-draft
# Кэш аватарок Telegram; по умолчанию каталог avatars рядом с MEDIA_DIR.
# AVATAR_DIR=./data/avatars
# Максимальный размер одного вложения и общий бюджет каталога.
# MEDIA_MAX_FILE_MB=45
# MEDIA_MAX_TOTAL_MB=1024

# --- Обновления ---
# Панель проверяет GitHub и создаёт заявку на точный release-тег. Docker
# socket приложению не передаётся; применяет заявку ограниченный systemd
# host-updater (install.sh или scripts/install-host-updater.sh).
# UPDATE_ENABLED=true
# UPDATE_REPOSITORY=tagashi666/ai-support
# prerelease показывает и RC, stable — только стабильные релизы.
# UPDATE_CHANNEL=stable
# UPDATE_CHECK_MINUTES=15
# UPDATE_REQUEST_FILE=./data/update-request.json
# UPDATE_STATUS_FILE=./data/update-status.json
# Добавление источников из панели использует отдельный executor.
# SOURCE_REQUEST_FILE=./data/source-request.json
# SOURCE_STATUS_FILE=./data/source-status.json

# LOG_LEVEL=info
